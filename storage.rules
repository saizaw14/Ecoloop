rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /waste-scans/{userId}/{scanId}.jpg {
      // Images are private to their uploader. Dataset exports should use a
      // trusted server environment (Admin SDK), which bypasses these rules.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
